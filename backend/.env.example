# CraftMind authentication service — non-secret examples only.
# Copy to .env for local development; never commit .env or real credentials.
# The memory provider accepts test deliveries into a private process-local sink and sends NO email.

NODE_ENV=development

# Persistent SQLite file. Tests may explicitly opt into :memory:; production may not.
DATABASE_URL=./var/craftmind-auth.db

# Generate a unique value per environment with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Bind to loopback unless a trusted TLS terminator is in front of the service.
HOST=127.0.0.1
PORT=8787

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
MAX_BODY_BYTES=16384

# Optional first-owner bootstrap only. Generate a 32-byte base64url secret outside Git, inject it for one deployment,
# complete POST /developer/auth/bootstrap once, then remove the secret from the deployment environment.
# The initial password is submitted once over HTTPS and hashed with the account service's scrypt policy; there is no
# environment password and normal developer login never depends on this bootstrap configuration.
CRAFTMIND_DEV_BOOTSTRAP_EMAIL=
CRAFTMIND_DEV_BOOTSTRAP_SECRET=
DEVELOPER_ACCESS_TOKEN_TTL_SECONDS=900
DEVELOPER_REFRESH_TOKEN_TTL_SECONDS=604800
DEVELOPER_CONFIRMATION_TTL_SECONDS=300

# Optional provider-neutral Developer AI configuration boundary. No provider adapter is bundled/enabled by these values;
# an installed adapter must be injected by the trusted server composition root. Never expose this key to Android.
CRAFTMIND_DEVELOPER_AI_PROVIDER=
CRAFTMIND_DEVELOPER_AI_MODEL=
CRAFTMIND_DEVELOPER_AI_API_KEY=

# Local default. This is a test sink, NOT an email provider. Production requires webhook.
EMAIL_PROVIDER=memory

# Production-only webhook configuration; set all values in the deployment environment, not in this file.
# NODE_ENV=production
# EMAIL_PROVIDER=webhook
# EMAIL_WEBHOOK_URL=https://mail-adapter.example.invalid/send
# EMAIL_WEBHOOK_TOKEN=
# EMAIL_FROM=accounts@example.invalid
# PUBLIC_ORIGIN=https://accounts.example.invalid
# TRUST_PROXY_TLS=true
# CORS_ALLOWED_ORIGINS=https://craftmind.example.invalid

# Limits are per process. Multi-instance deployments must apply equivalent limits at a trusted edge/shared store.
RATE_LOGIN_MAX=10
RATE_LOGIN_WINDOW_MS=900000
RATE_REGISTER_MAX=60
RATE_REGISTER_WINDOW_MS=3600000
RATE_VERIFY_MAX=10
RATE_VERIFY_WINDOW_MS=900000
RATE_RESEND_MAX=3
RATE_RESEND_WINDOW_MS=3600000
RATE_RESET_REQUEST_MAX=5
RATE_RESET_REQUEST_WINDOW_MS=3600000
RATE_RESET_CONFIRM_MAX=10
RATE_RESET_CONFIRM_WINDOW_MS=900000
RATE_SESSION_MAX=60
RATE_SESSION_WINDOW_MS=900000
RATE_DEV_BOOTSTRAP_MAX=5
RATE_DEV_BOOTSTRAP_WINDOW_MS=900000
RATE_DEV_LOGIN_MAX=5
RATE_DEV_LOGIN_WINDOW_MS=900000
RATE_DEV_SESSION_MAX=30
RATE_DEV_SESSION_WINDOW_MS=900000
RATE_DEV_ADMIN_MAX=120
RATE_DEV_ADMIN_WINDOW_MS=900000
RATE_DEV_AI_MAX=10
RATE_DEV_AI_WINDOW_MS=60000


# Autonomous security response (Phase 20). Every value is a bounded integer; the engine ships with safe defaults.
# Detection thresholds: MEDIUM < HIGH < CRITICAL signals inside the window, per subject (account, session, or source).
SECURITY_BRUTE_FORCE_WINDOW_MS=120000
SECURITY_BRUTE_FORCE_MEDIUM_MAX=5
SECURITY_BRUTE_FORCE_HIGH_MAX=12
SECURITY_BRUTE_FORCE_CRITICAL_MAX=25
SECURITY_DEVELOPER_AUTH_FAILURES_WINDOW_MS=120000
SECURITY_DEVELOPER_AUTH_FAILURES_MEDIUM_MAX=3
SECURITY_DEVELOPER_AUTH_FAILURES_HIGH_MAX=6
SECURITY_DEVELOPER_AUTH_FAILURES_CRITICAL_MAX=12
# Stale-credential retries are routine for clients, so session reuse watches sustained activity.
SECURITY_SESSION_ABUSE_WINDOW_MS=300000
SECURITY_SESSION_ABUSE_MEDIUM_MAX=8
SECURITY_SESSION_ABUSE_HIGH_MAX=15
SECURITY_SESSION_ABUSE_CRITICAL_MAX=25
SECURITY_RATE_LIMIT_ABUSE_WINDOW_MS=600000
SECURITY_RATE_LIMIT_ABUSE_MEDIUM_MAX=3
SECURITY_RATE_LIMIT_ABUSE_HIGH_MAX=8
SECURITY_RATE_LIMIT_ABUSE_CRITICAL_MAX=15
SECURITY_UNAUTHORIZED_ACCESS_WINDOW_MS=600000
SECURITY_UNAUTHORIZED_ACCESS_MEDIUM_MAX=5
SECURITY_UNAUTHORIZED_ACCESS_HIGH_MAX=10
SECURITY_UNAUTHORIZED_ACCESS_CRITICAL_MAX=20
SECURITY_CONFIRMATION_ABUSE_WINDOW_MS=600000
SECURITY_CONFIRMATION_ABUSE_MEDIUM_MAX=3
SECURITY_CONFIRMATION_ABUSE_HIGH_MAX=6
SECURITY_CONFIRMATION_ABUSE_CRITICAL_MAX=12
SECURITY_MALFORMED_REQUESTS_WINDOW_MS=300000
SECURITY_MALFORMED_REQUESTS_MEDIUM_MAX=5
SECURITY_MALFORMED_REQUESTS_HIGH_MAX=10
SECURITY_MALFORMED_REQUESTS_CRITICAL_MAX=20
SECURITY_REQUEST_BURST_WINDOW_MS=60000
SECURITY_REQUEST_BURST_MEDIUM_MAX=120
SECURITY_REQUEST_BURST_HIGH_MAX=240
SECURITY_REQUEST_BURST_CRITICAL_MAX=400

# Automated protections are always temporary: durations are clamped to the maximum, never permanent.
SECURITY_DEFAULT_PROTECTION_SECONDS=900
SECURITY_MAX_PROTECTION_SECONDS=3600
SECURITY_THROTTLE_MAX=5
SECURITY_THROTTLE_WINDOW_MS=300000

# --- Phase 22: membership, entitlements, and build credits -------------------------------------------------------
# Every limit the entitlement engine and the credit ledger enforce lives here. Nothing below is a price, and no value
# below enables a purchase: there is no payment provider, checkout, or settlement in this phase.
#
# Daily generation allowances are recorded per plan for the future AI gateway. They are NOT enforced yet, and this
# phase blocks no request on them.
MEMBERSHIP_FREE_DAILY_GENERATIONS=10
# Internal promotional credit allocations applied only when an authorized developer tool grants a plan. They are not
# purchase entitlements, and the free plan grants none by default.
MEMBERSHIP_FREE_PROMOTIONAL_CREDITS=0
MEMBERSHIP_PRO_PROMOTIONAL_CREDITS=200
MEMBERSHIP_CREATOR_PROMOTIONAL_CREDITS=500
MEMBERSHIP_SERVER_PROMOTIONAL_CREDITS=1000
# Default lifetime of granted credits, and the horizon the "expiring soon" figure reports.
MEMBERSHIP_CREDIT_EXPIRY_DAYS=90
# Bounds that make an unbounded grant, an unbounded consumption, or an unbounded plan impossible.
MEMBERSHIP_MAX_GRANT_CREDITS=10000
MEMBERSHIP_MAX_CONSUME_CREDITS=100
MEMBERSHIP_MAX_PLAN_GRANT_DAYS=365
MEMBERSHIP_MAX_TRANSACTION_PAGE=100
# Expired credits are reconciled in bounded batches when a balance is read; there is no background job.
MEMBERSHIP_RECONCILIATION_BATCH=50

# Account-surface rate limits. Reading entitlement state is cheap; spending credits is a state change.
RATE_CREDITS_MAX=120
RATE_CREDITS_WINDOW_MS=900000
RATE_CREDIT_CONSUME_MAX=30
RATE_CREDIT_CONSUME_WINDOW_MS=900000

# Android Gradle is configured separately; this backend process does not consume the build-time app URL.
# Set it in the Android build environment only when a real HTTPS account service is available:
# CRAFTMIND_ACCOUNT_BASE_URL=https://auth.example.invalid
