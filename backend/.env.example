# CraftMind account service — environment.
#
# Copy to `.env` (which is git-ignored) for local development, or export the variables in your process manager.
# NEVER commit a real `.env`, and never place a real secret in the Android app, Gradle files, resources, the website,
# or a test.

# ----------------------------------------------------------------------------------------------------------------
# Backend service
# ----------------------------------------------------------------------------------------------------------------

# SQLite database file. The service creates the file and applies its migrations on start.
DATABASE_URL=./var/craftmind-auth.db

# Key material the server uses to derive the digest it stores for a session token. The raw token is never stored, so a
# copy of the database alone cannot be replayed against the API. Generate one per environment, for example:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Interface and port. Bind to the loopback address unless a TLS terminator is in front of this process.
HOST=127.0.0.1
PORT=8787

# Session lifetimes in seconds. Access tokens are short-lived; refresh tokens are rotated on every refresh.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Maximum accepted JSON request body, in bytes.
MAX_BODY_BYTES=16384

# ----------------------------------------------------------------------------------------------------------------
# Android client
# ----------------------------------------------------------------------------------------------------------------

# HTTPS base URL of the account service the app talks to, WITHOUT a trailing slash.
# The app must be built with -PcraftmindAccountBaseUrl=... or with this exported as CRAFTMIND_ACCOUNT_BASE_URL;
# when it is empty the app ships with no account service configured and says so instead of pretending to sign in.
# Plain HTTP is refused by the client, and the Android manifest keeps cleartext traffic disabled.
BACKEND_BASE_URL=https://auth.example.invalid
