# CraftMind authentication service — non-secret examples only.
# Copy to .env for local development; never commit .env or real credentials.
# The memory provider accepts test deliveries into a private process-local sink and sends NO email.

NODE_ENV=development

# Persistent SQLite file. Tests may explicitly opt into :memory:; production may not.
DATABASE_URL=./var/craftmind-auth.db

# Generate a unique value per environment with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Bind to loopback unless a trusted TLS terminator is in front of the service.
HOST=127.0.0.1
PORT=8787

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
MAX_BODY_BYTES=16384

# Optional first-owner bootstrap only. Generate a 32-byte base64url secret outside Git, inject it for one deployment,
# complete POST /developer/auth/bootstrap once, then remove the secret from the deployment environment.
# The initial password is submitted once over HTTPS and hashed with the account service's scrypt policy; there is no
# environment password and normal developer login never depends on this bootstrap configuration.
CRAFTMIND_DEV_BOOTSTRAP_EMAIL=
CRAFTMIND_DEV_BOOTSTRAP_SECRET=
DEVELOPER_ACCESS_TOKEN_TTL_SECONDS=900
DEVELOPER_REFRESH_TOKEN_TTL_SECONDS=604800
DEVELOPER_CONFIRMATION_TTL_SECONDS=300

# Optional provider-neutral Developer AI configuration boundary. No provider adapter is bundled/enabled by these values;
# an installed adapter must be injected by the trusted server composition root. Never expose this key to Android.
CRAFTMIND_DEVELOPER_AI_PROVIDER=
CRAFTMIND_DEVELOPER_AI_MODEL=
CRAFTMIND_DEVELOPER_AI_API_KEY=

# Local default. This is a test sink, NOT an email provider. Production requires webhook.
EMAIL_PROVIDER=memory

# Production-only webhook configuration; set all values in the deployment environment, not in this file.
# NODE_ENV=production
# EMAIL_PROVIDER=webhook
# EMAIL_WEBHOOK_URL=https://mail-adapter.example.invalid/send
# EMAIL_WEBHOOK_TOKEN=
# EMAIL_FROM=accounts@example.invalid
# PUBLIC_ORIGIN=https://accounts.example.invalid
# TRUST_PROXY_TLS=true
# CORS_ALLOWED_ORIGINS=https://craftmind.example.invalid

# Limits are per process. Multi-instance deployments must apply equivalent limits at a trusted edge/shared store.
RATE_LOGIN_MAX=10
RATE_LOGIN_WINDOW_MS=900000
RATE_REGISTER_MAX=60
RATE_REGISTER_WINDOW_MS=3600000
RATE_VERIFY_MAX=10
RATE_VERIFY_WINDOW_MS=900000
RATE_RESEND_MAX=3
RATE_RESEND_WINDOW_MS=3600000
RATE_RESET_REQUEST_MAX=5
RATE_RESET_REQUEST_WINDOW_MS=3600000
RATE_RESET_CONFIRM_MAX=10
RATE_RESET_CONFIRM_WINDOW_MS=900000
RATE_SESSION_MAX=60
RATE_SESSION_WINDOW_MS=900000
RATE_DEV_BOOTSTRAP_MAX=5
RATE_DEV_BOOTSTRAP_WINDOW_MS=900000
RATE_DEV_LOGIN_MAX=5
RATE_DEV_LOGIN_WINDOW_MS=900000
RATE_DEV_SESSION_MAX=30
RATE_DEV_SESSION_WINDOW_MS=900000
RATE_DEV_ADMIN_MAX=120
RATE_DEV_ADMIN_WINDOW_MS=900000
RATE_DEV_AI_MAX=10
RATE_DEV_AI_WINDOW_MS=60000

# Android Gradle is configured separately; this backend process does not consume the build-time app URL.
# Set it in the Android build environment only when a real HTTPS account service is available:
# CRAFTMIND_ACCOUNT_BASE_URL=https://auth.example.invalid
